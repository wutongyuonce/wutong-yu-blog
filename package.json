{
  "name": "wutong-yu",
  "version": "2.4.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "sync": "astro sync",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build --force",
    "preview": "astro preview",
    "test:blog-tags": "node --test test/blog-tag-filter.test.mjs",
    "test:blog-stats": "node --test test/blog-stats.test.mjs",
    "test:progress-stats": "node --test test/progress-stats.test.mjs",
    "test:recent-post-date": "node --test test/recent-post-date.test.mjs",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown --cache",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "toolbar:on": "astro preferences enable devToolbar",
    "toolbar:off": "astro preferences disable devToolbar",
    "postbuild": "pagefind --site dist --exclude-selectors \"pre\" --include-characters \"<>\" && node ./scripts/postbuild.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^6.3.8",
    "@astrojs/mdx": "^4.3.7",
    "@astrojs/sitemap": "^3.6.0",
    "@eslint/js": "^10.0.0",
    "@expressive-code/plugin-collapsible-sections": "^0.44.0",
    "@expressive-code/plugin-line-numbers": "^0.44.0",
    "@iconify/json": "^2.2.464",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.7.2",
    "@typescript-eslint/parser": "^8.46.0",
    "@unocss/reset": "66.5.3",
    "astro": "^5.14.4",
    "astro-expressive-code": "^0.44.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.0.0",
    "html-entities": "^2.6.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^1.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.1.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-directive-sugar": "^2.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.33.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "unist-util-visit": "^5.1.0",
    "unocss": "66.5.3",
    "vfile": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": "18.20.8 || ^20.9.0 || ^22.0.0"
  }
}
