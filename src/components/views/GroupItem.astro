---
import Link from '~/components/base/Link.astro'
import { UI } from '~/config'

export interface GroupItemData {
  id: string
  link: string
  desc: string
  icon?: string
}

interface Props {
  items: GroupItemData[]
}

const { items } = Astro.props
const { maxGroupColumns, showGroupItemColorOnHover } = UI.groupView
---

<div
  class="group-grid"
  style={`--group-columns: ${maxGroupColumns};`}
>
  {
    items.map((item) => (
      <Link
        class="group-card"
        href={item.link}
        external={true}
      >
        {item.icon && (
          <div class="group-card__icon-wrap" aria-hidden="true">
            <div
              class={`group-card__icon ${item.icon}`}
              data-show-color={showGroupItemColorOnHover ? '' : undefined}
            />
          </div>
        )}
        <div class="group-card__body">
          <div class="group-card__title">{item.id}</div>
          <div class="group-card__desc">{item.desc}</div>
        </div>
      </Link>
    ))
  }
</div>

<style>
  .group-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
    margin: 0 auto;
    max-width: calc(
      350px * var(--group-columns) + (var(--group-columns) - 1) * 0.5rem
    );
  }

  .group-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-width: 0;
    padding: 0.75rem 0.875rem;
    border-radius: 0.625rem;
    background: #f0f0f0;
    border-bottom: none !important;
    font-size: 1.1rem;
    transition: background-color 0.2s ease;
  }

  .group-card:hover {
    background: #e8e8e8;
  }

  :global(.dark) .group-card {
    background: #ffffff14;
  }

  :global(.dark) .group-card:hover {
    background: #ffffff24;
  }

  .group-card__icon-wrap {
    flex: 0 0 auto;
    padding-top: 0.125rem;
    padding-inline-end: 0.75rem;
  }

  .group-card__icon {
    line-height: 1.5rem;
    font-size: 1.25rem;
    opacity: 0.5;
    filter: saturate(0);
    transition:
      filter 0.3s ease,
      opacity 0.3s ease;
  }

  .group-card:hover .group-card__icon[data-show-color] {
    filter: saturate(1);
  }

  .group-card__body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .group-card__title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .group-card__desc {
    opacity: 0.5;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
    margin-top: 0.125rem;
  }

  @media (max-width: 1127.9px) {
    .group-grid {
      max-width: 100% !important;
    }
  }

  @media (max-width: 767.9px) {
    .group-grid {
      grid-template-columns: 1fr;
      max-width: 100% !important;
    }
  }
</style>
