---
import Link from '~/components/base/Link.astro'

const dataFilePath = 'src/content/friends/data.json'
const prUrl =
  'https://github.com/wutongyuonce/wutong-yu-blog/edit/main/src/content/friends/data.json'

const friendInfo = {
  name: 'Wutong Yu',
  desc: 'Exploring technology and life',
  link: 'https://www.wutongyu.site/',
  avatar: 'https://www.wutongyu.site/avatar.webp',
}

const referenceTemplate = `Name: ${friendInfo.name}
Desc: ${friendInfo.desc}
Link: ${friendInfo.link}
Avatar: ${friendInfo.avatar}`
---

<aside class="friends-apply" aria-label="申请友链">
  <section class="friends-apply__intro">
    <p class="friends-apply__kicker">Apply</p>
    <h3>交换友链</h3>
    <ol class="friends-apply__rules">
      <li>
        <span class="friends-apply__index">01</span>
        <span class="friends-apply__rule-text">先友后链</span>
      </li>
      <li>
        <span class="friends-apply__index">02</span>
        <span class="friends-apply__rule-text">站点使用 https 协议</span>
      </li>
    </ol>
    <p class="friends-apply__hint">
      在仓库的 <code>{dataFilePath}</code> 数组末尾追加一条对象，补上上一项的逗号，然后提交
      Pull Request。
    </p>
    <Link href={prUrl} external={true} class="friends-apply__pr op-100">
      在 GitHub 提交 PR
    </Link>
  </section>

  <section class="friends-apply__block">
    <h3>参考格式</h3>
    <div class="friends-apply__code-wrap">
      <pre id="friend-format">{referenceTemplate}</pre>
      <button
        class="friends-apply__copy"
        type="button"
        data-copy-target="friend-format"
        aria-label="复制参考格式"
      >
        复制
      </button>
    </div>
  </section>
</aside>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-copy-target]')
    .forEach((button) => {
      button.addEventListener('click', async () => {
        const target = document.getElementById(button.dataset.copyTarget ?? '')
        if (!target) return

        try {
          await navigator.clipboard.writeText(target.textContent ?? '')
          button.textContent = '已复制'
        } catch {
          button.textContent = '复制失败'
        }
        setTimeout(() => {
          button.textContent = '复制'
        }, 1600)
      })
    })
</script>

<style>
  .friends-apply {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    border: 1px solid var(--friends-border);
    border-radius: 1.8rem;
    background: var(--friends-panel-bg);
    overflow: hidden;
  }

  .friends-apply__intro {
    padding: 1.25rem 1.15rem 1.35rem 1.3rem;
  }

  .friends-apply__block {
    padding: 1.25rem 1.5rem 1.35rem 1.2rem;
  }

  .friends-apply__intro {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    min-width: 0;
    border-right: 1px solid var(--friends-border);
  }

  .friends-apply__kicker {
    margin: 0;
    color: var(--friends-subtle);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .friends-apply h3 {
    margin: 0;
    color: var(--friends-subtle);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .friends-apply__intro h3 {
    color: var(--c-text);
    font-size: 1.05rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .friends-apply__rules {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.5rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .friends-apply__rules li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--c-text);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .friends-apply__index {
    color: var(--friends-subtle);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .friends-apply__rule-text {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .friends-apply__hint {
    margin: 0.1rem 0 0;
    color: var(--friends-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .friends-apply__hint code {
    color: var(--c-text);
    font-size: 0.84em;
    overflow-wrap: anywhere;
  }

  .friends-apply__pr {
    margin-top: 0.2rem;
    justify-self: start;
    padding: 0.38rem 0.78rem;
    border: 1px solid var(--friends-border);
    border-radius: 0.55rem;
    background: var(--c-bg);
    color: var(--friends-muted);
    font-size: 0.86rem;
    line-height: 1.4;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .friends-apply__pr:hover {
    border-color: var(--friends-border-strong);
    color: var(--c-text);
  }

  .friends-apply__block {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-width: 0;
  }

  .friends-apply__code-wrap {
    position: relative;
  }

  .friends-apply pre {
    margin: 0;
    padding: 0.9rem 3.6rem 0.9rem 0.9rem;
    border: 1px solid var(--friends-border);
    border-radius: 0.9rem;
    background: var(--c-bg);
    color: var(--c-text);
    font-size: 0.84rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .friends-apply__copy {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--friends-border);
    border-radius: 0.55rem;
    background: var(--c-bg);
    color: var(--friends-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
  }

  .friends-apply__copy:hover {
    color: var(--c-text);
  }

  @media (max-width: 920px) {
    .friends-apply {
      grid-template-columns: 1fr;
      border-radius: 1.25rem;
    }

    .friends-apply__intro,
    .friends-apply__block {
      padding: 1.1rem;
    }

    .friends-apply__intro {
      border-right: 0;
      border-bottom: 1px solid var(--friends-border);
    }

    .friends-apply pre {
      padding: 0.8rem 3.4rem 0.8rem 0.8rem;
      font-size: 0.82rem;
    }
  }
</style>
