    color: color-mix(in srgb, var(--c-text) 58%, transparent);
    white-space: nowrap;
  }

  .progress-stat {
    display: grid;
    gap: 0.12rem;
  }

  .progress-stat strong {
    color: color-mix(in srgb, var(--c-text) 78%, transparent);
    font-family:
