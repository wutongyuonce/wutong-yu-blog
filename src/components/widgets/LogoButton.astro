---
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import { SITE } from '~/config'
---

<Link
  class="select-none op-transition"
  href={withBasePath('/')}
  aria-label={SITE.author}
  aria-current={Astro.url.pathname === `${withBasePath('/')}` ? 'page' : false}
>
  <div class="logo-container">
    <img
      class="logo-icon"
      src={withBasePath('/avatar.webp')}
      alt=""
      aria-hidden="true"
      width="48"
      height="48"
    />
  </div>
</Link>

<style>
  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    transform: scale(1.05);
  }

  @media (max-width: 767.9px) {
    .logo-container {
      margin-top: 0.125rem;

      transform-origin: 0%;
      transform: scale(0.95);
    }
  }

  .logo-icon {
    width: 3rem;
    height: 3rem;
    display: block;
    object-fit: cover;
    box-sizing: border-box;
    border: 2px solid rgb(31 41 55 / 72%);
    border-radius: 50%;
    box-shadow: 0 1px 4px rgb(0 0 0 / 18%);
  }

  :global(html.dark) .logo-icon {
    border-color: rgb(255 255 255 / 78%);
    box-shadow: 0 1px 5px rgb(0 0 0 / 55%);
  }
</style>
