---
import { SITE } from '~/config'
import { formatDate } from '~/utils/datetime'

interface Props {
  title: string
  description: string
  intro: string
  pubDate: string
  tags: string[]
}

const { title, description, intro, pubDate, tags } = Astro.props
const link = new URL(Astro.url.pathname, SITE.website).toString()
---

<span
  class="post-card-export"
  data-post-card
  data-title={title}
  data-description={description}
  data-intro={intro}
  data-pub-date={formatDate(pubDate)}
  data-tags={tags.join(' · ')}
  data-link={link}
>
  <button type="button" aria-label="导出文章展示卡" title="导出展示卡">
    <span aria-hidden="true">↗</span> 导出卡片
  </button>
</span>

<script>
  const ARTWORKS = [
    '/blog-card-art/abstract-1.jpg',
    '/blog-card-art/abstract-2.jpg',
    '/blog-card-art/abstract-3.jpg',
  ]

  const wrap = (ctx: CanvasRenderingContext2D, text: string, width: number, lines: number) => {
    const result: string[] = []
    let line = ''

    for (const char of text) {
      if (ctx.measureText(line + char).width <= width) line += char
      else {
        result.push(line)
        line = char
        if (result.length === lines) break
      }
    }
    if (line && result.length < lines) result.push(line)
    if (result.length === lines && result.join('').length < text.length)
      result[lines - 1] = `${result[lines - 1].slice(0, -1)}…`
    return result
  }

  const loadImage = (src: string) => new Promise<HTMLImageElement | null>((resolve) => {
    const image = new Image()
    image.onload = () => resolve(image)
    image.onerror = () => resolve(null)
    image.src = src
  })

  const drawContained = (
    ctx: CanvasRenderingContext2D,
    image: HTMLImageElement,
    x: number,
    y: number,
    width: number,
    height: number
  ) => {
    const scale = Math.min(width / image.naturalWidth, height / image.naturalHeight)
    const drawWidth = image.naturalWidth * scale
    const drawHeight = image.naturalHeight * scale
    ctx.drawImage(image, x + (width - drawWidth) / 2, y + (height - drawHeight) / 2, drawWidth, drawHeight)
  }

  const drawCard = async (button: HTMLButtonElement) => {
    const host = button.closest<HTMLElement>('[data-post-card]')
    if (!host) return

    const { title = '', description = '', intro = '', pubDate = '', tags = '', link = '' } = host.dataset
    const canvas = document.createElement('canvas')
    const cardWidth = 2400
    const cardHeight = 1260
    canvas.width = cardWidth * 2
    canvas.height = cardHeight * 2
    const ctx = canvas.getContext('2d')
    if (!ctx) return
    ctx.scale(2, 2)

    const artwork = ARTWORKS[Math.floor(Math.random() * ARTWORKS.length)]
    const [art, avatar] = await Promise.all([
      loadImage(artwork),
      loadImage('/avatar.webp'),
      document.fonts?.ready,
    ])

    ctx.save()
    ctx.beginPath()
    ctx.roundRect(0, 0, cardWidth, cardHeight, 72)
    ctx.clip()

    ctx.fillStyle = '#050505'
    ctx.fillRect(0, 0, cardWidth, cardHeight)

    ctx.strokeStyle = '#292929'
    ctx.lineWidth = 2
    ctx.beginPath()
    ctx.moveTo(1320, 120)
    ctx.lineTo(1320, 1140)
    ctx.stroke()

    ctx.fillStyle = '#8d8d8d'
    ctx.font = '500 30px ui-sans-serif, system-ui, sans-serif'
    ctx.fillText('WUTONG YU  /  BLOG', 140, 150)

    ctx.fillStyle = '#f4f4ef'
    ctx.font = '400 112px "LXGWWenKai-Regular", sans-serif'
    const titleLines = wrap(ctx, title, 1050, 3)
    titleLines.forEach((line, index) => ctx.fillText(line, 140, 315 + index * 120))

    const metaY = 315 + (Math.max(titleLines.length, 1) - 1) * 120 + 85
    ctx.fillStyle = '#a8a8a8'
    ctx.font = '500 34px ui-sans-serif, system-ui, sans-serif'
    ctx.fillText([pubDate, tags].filter(Boolean).join('  ·  '), 140, metaY)

    ctx.fillStyle = '#e1e1dc'
    ctx.font = '400 46px ui-sans-serif, system-ui, sans-serif'
    const descriptionLines = wrap(ctx, description || title, 1040, 2)
    const descriptionY = metaY + 180
    descriptionLines.forEach((line, index) => ctx.fillText(line, 140, descriptionY + index * 64))

    ctx.fillStyle = '#777'
    ctx.font = '400 28px ui-sans-serif, system-ui, sans-serif'
    wrap(ctx, intro, 1040, 2).forEach((line, index) =>
      ctx.fillText(line, 140, descriptionY + descriptionLines.length * 64 + 21 + index * 42)
    )

    const linkText = decodeURI(link)
    ctx.fillStyle = '#f4f4ef'
    ctx.font = '400 30px ui-monospace, SFMono-Regular, monospace'
    ctx.fillText(linkText, 140, 1130)
    ctx.fillRect(140, 1146, ctx.measureText(linkText).width, 2)

    if (art) drawContained(ctx, art, 1390, 170, 840, 900)
    if (avatar) {
      ctx.save()
      ctx.beginPath()
      ctx.arc(2200, 120, 64, 0, Math.PI * 2)
      ctx.clip()
      ctx.drawImage(avatar, 2136, 56, 128, 128)
      ctx.restore()
      ctx.strokeStyle = '#fff'
      ctx.shadowColor = '#fff'
      ctx.shadowBlur = 28
      ctx.lineWidth = 3
      ctx.beginPath()
      ctx.arc(2200, 120, 64, 0, Math.PI * 2)
      ctx.stroke()
      ctx.shadowBlur = 0
    }
    ctx.restore()

    canvas.toBlob((blob) => {
      if (!blob) return
      const download = document.createElement('a')
      download.href = URL.createObjectURL(blob)
      download.download = `${(title || 'blog').replace(/[\\/:*?"<>|]/g, '-')}-card.png`
      download.click()
      URL.revokeObjectURL(download.href)
    }, 'image/png')
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-post-card] button')
    if (button) drawCard(button)
  })
</script>

<style>
  .post-card-export button {
    border: 1px solid #0000001f;
    border-radius: 999px;
    background: #ffffffb3;
    color: var(--fg-deep);
    cursor: pointer;
    font: inherit;
    padding: 0.25rem 0.7rem;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .post-card-export button:hover,
  .post-card-export button:focus-visible {
    background: #fff;
    border-color: #00000040;
  }

  :global(html.dark) .post-card-export button {
    border-color: #ffffff2e;
    background: #ffffff0d;
    color: #eee;
  }

  :global(html.dark) .post-card-export button:hover,
  :global(html.dark) .post-card-export button:focus-visible {
    background: #ffffff1a;
    border-color: #ffffff59;
  }
</style>
