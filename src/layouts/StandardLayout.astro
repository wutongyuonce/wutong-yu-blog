---
interface Props {
  title?: string
  subtitle?: string
  isCentered?: boolean
  isArticle?: boolean
  isSearchable?: boolean
  searchFilter?: string
  class?: string
}

const {
  title,
  subtitle,
  isCentered = false,
  isArticle = false,
  isSearchable,
  searchFilter,
  class: className,
} = Astro.props
---

<header
  class:list={[
    'page-header prose mx-auto',
    { 'text-center': isCentered, 'post-header': isArticle },
  ]}
>
  {
    title && (
      <div class:list={['title-row', { 'post-title-row': isArticle }]}>
        <h1 class="page-title">{title}</h1>
        {isArticle && <slot name="title-action" />}
      </div>
    )
  }
  {
    subtitle && (
      <p class={`${isArticle ? 'mt--2!' : 'mt--8!'} op-50 italic`}>
        {subtitle}
      </p>
    )
  }
  <slot name="head" />
</header>
{
  Astro.slots.has('article') && (
    <article
      class:list={[
        'slide-enter-content prose mx-auto',
        { 'post-content': isArticle },
      ]}
      data-pagefind-body={isSearchable ? '' : undefined}
      data-pagefind-filter={
        isSearchable && searchFilter ? searchFilter : undefined
      }
    >
      <slot name="article" />
    </article>
  )
}

<style>
  .page-header {
    margin-bottom: 3.5rem;
  }

  .post-header {
    margin-bottom: 1.75rem;
  }

</style>
{
  Astro.slots.has('default') && (
    <div class:list={['mx-auto', className]}>
      <slot />
    </div>
  )
}
